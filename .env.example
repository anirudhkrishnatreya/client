# API base URL. Leave unset in development: Vite proxies /api to http://localhost:5001.
# REQUIRED before `npm run deploy` / any production build — GitHub Pages serves static files only, so
# without this the built app calls the relative path /api on its own static domain and every request 405s.
VITE_API_URL=https://imenteo-backend.onrender.com/api

# v4 assessment (three age tracks). Off unless set to "on" at BUILD time, so it cannot be exposed by accident.
# VITE_V4=on
# Learning platform dashboards (student, mentor, parent). Off unless the build says on; they run on sample data until the API exists.
# VITE_PLATFORM=on

# Contact address shown in the landing page footer (leave unset to hide it)
# VITE_CONTACT_EMAIL=hello@example.com
